{
  "name": "@spark/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc",
    "dev": "node --loader ts-node/esm --watch src/main.ts",
    "test": "vitest run",
    "start": "node --loader ts-node/esm src/main.ts",
    "emit:openapi": "node --loader ts-node/esm scripts/emit-openapi.mts"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "@nestjs/testing": "^11.2.3",
    "postgres": "^3.4.9",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@nestjs/core": "^11.2.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/swagger": "^11.4.7",
    "nestjs-zod": "^5.5.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "zod": "^4.6.1",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/api": "^1.9.1",
    "@spark/core": "workspace:*",
    "@spark/db": "workspace:*",
    "fastify": "^5.12.3",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^17.4.2"
  }
