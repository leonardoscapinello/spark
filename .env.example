# Copie para .env e preencha. Nunca commitar .env — ver .gitignore e ADR-0011.

# --- Postgres (local: docker-compose · produção: Supabase, sa-east-1) ---
# admin — usada só por migration/seed (bypassa RLS nesta imagem Supabase)
DATABASE_URL=postgresql://postgres:spark_dev@localhost:5432/spark
# app_user — a que apps/api, worker e scheduler usam de verdade em runtime;
# RLS se aplica a ela (docs/adr/0022, packages/db/README.md)
DATABASE_URL_APP=postgresql://app_user:app_user_dev_password@localhost:5432/spark

# --- Supabase (Auth, Realtime, Storage-fallback) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_VERIFICATION=jwks
SUPABASE_JWKS_URL=
SUPABASE_AUTH_ISSUER=

# --- Electric (sync local-first — ADR-0018) ---
ELECTRIC_URL=http://localhost:3010

# --- Redis/Valkey (filas — ADR-0009) ---
REDIS_URL=redis://localhost:6379

# --- Storage S3-compatível (ADR-0028) — hoje aponta pro Supabase Storage ---
S3_ENDPOINT=
S3_BUCKET=spark-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- E-mail (ADR-0016) — local: Mailpit em localhost:1025, sem chave ---
RESEND_API_KEY=
REOON_API_KEY=

# --- Meta Cloud API (ADR-0010, 0016) ---
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Buffer (driver de social — ADR-0016) ---
BUFFER_API_KEY=

# --- Observabilidade (ADR-0013) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- App ---
NODE_ENV=development
PORT=3000
JWT_SECRET=dev-only-change-me
# origem do apps/web — apps/api libera CORS só pra ela (ADR-0015)
WEB_ORIGIN=http://localhost:3100
