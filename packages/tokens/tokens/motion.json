          0.22,
          1,
          0.36,
          1
        ]
      },
      "inOut": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0,
          0.35,
          1
        ]
      },
      "spring": {
        "$type": "cubicBezier",
        "$value": [
          0.34,
          1.22,
          0.64,
          1
        ]
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.6,
          1
        ]
      }
    },
    "duration": {
      "instant": {
