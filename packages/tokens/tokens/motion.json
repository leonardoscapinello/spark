      },
      "deliberate": {
        "$type": "duration",
        "$value": "700ms"
      },
      "exit": {
        "$type": "duration",
        "$value": "280ms"
      },
      "control": {
        "$type": "duration",
        "$value": "180ms"
      },
      "selection": {
